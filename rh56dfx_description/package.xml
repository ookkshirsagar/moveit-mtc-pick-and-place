<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rh56dfx_description</name>
  <version>1.0.0</version>
  <description>URDF/xacro description, meshes and joint limits of the Inspire RH56DFX dexterous hand (left and right)</description>
  <maintainer email="ookkshirsagar@gmail.com">Omkar Chandrakant Kshirsagar</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ookkshirsagar/moveit-mtc-pick-and-place</url>
  <author email="ookkshirsagar@gmail.com">Omkar Chandrakant Kshirsagar</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
