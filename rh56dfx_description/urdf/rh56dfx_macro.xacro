<?xml version="1.0" encoding="utf-8"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="rh56dfx_hand" params="side prefix">

  <!--
  ======================================================================
  INSPIRE HAND RH56DFX - PARAMETRIC MACRO
  ======================================================================
  -->

  <!-- ============================================================= -->
  <!-- MESH ROOT DIRECTORY                                           -->
  <!-- ============================================================= -->

  <xacro:property name="mesh_root"
    value="package://rh56dfx_description/meshes/${side}"/>

  <xacro:property name="mesh_visual"
    value="${mesh_root}/visual"/>

  <xacro:property name="mesh_collision"
    value="${mesh_root}/collision"/>

  <!-- ============================================================= -->
  <!-- ROOT LINK (KINEMATIC ANCHOR)                                  -->
  <!-- ============================================================= -->

    <link name="${prefix}hand_root"/>

    <joint name="${prefix}hand_root_joint" type="fixed">
      <parent link="${prefix}hand_root"/>
      <child link="${prefix}wrist_base_link"/>
    </joint>

  <!-- ============================================================= -->
  <!--     WRIST BASE LINK                                           -->
  <!-- ============================================================= -->
  

  <link name="${prefix}wrist_base_link">

    <!-- ================= INERTIAL ================= -->

    <inertial>
      <origin
        xyz="0.00191998775838077 -2.17534676938413E-08 0.0332314674517473"
        rpy="0 0 0" />
      <mass
        value="0.0695038666375085" />
      <inertia
        ixx="3.02480603452712E-05"
        ixy="-6.93925958512878E-11"
        ixz="5.01503749466725E-07"
        iyy="3.10214964795132E-05"
        iyz="-1.99074603834946E-11"
        izz="2.86515789056302E-05" />
    </inertial>


    <!-- ================= VISUAL ================= -->

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}wrist_base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}wrist_base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>


  <!-- ========================================================= -->
  <!-- Wrist yaw joint                                          -->
  <!-- ========================================================= -->


  <link name="${prefix}wrist_yaw">

    <!-- ================= INERTIAL ================= -->

    <!-- Left Hand Inertial -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin
          xyz="2.01072214434106E-11 0.00545897802039832 -0.0131919975376266"
          rpy="0 0 0" />
        <mass
          value="0.00277890553366271" />
        <inertia
          ixx="2.26417227467369E-07"
          ixy="8.61095341004759E-17"
          ixz="-2.38081373178298E-16"
          iyy="1.49079741679729E-07"
          iyz="-1.48845836759757E-08"
          izz="1.09370482342779E-07" />
      </inertial>
    </xacro:if>

    <!-- Right Hand Inertial -->
    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin
          xyz="3.75516494205945E-11 0.00545897820466844 0.0131919971923186"
          rpy="0 0 0" />
        <mass
          value="2.7789055337E-03" />
        <inertia
          ixx="2.2641722747E-07"
          ixy="-8.6109534100E-17"
          ixz="2.3808137318E-16"
          iyy="1.4907974168E-07"
          iyz="1.4884583676E-08"
          izz="1.0937048234E-07" />
      </inertial>
    </xacro:if>

    <!-- ================= VISUAL ================= -->

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}wrist_yaw.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}wrist_yaw.STL" />
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>


  <joint
    name="${prefix}wrist_yaw_joint"
    type="revolute">

    <!-- ================= ORIGIN ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <origin
        xyz="-0.0055 0 0.0785"
        rpy="1.5708 0 -1.5708" />
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <origin
        xyz="-0.0055 0 0.0785"
        rpy="1.5708 0 1.5708" />
    </xacro:if>

    <parent link="${prefix}wrist_base_link" />
    <child  link="${prefix}wrist_yaw" />

    <axis xyz="0 0 -1" />

    <!-- ================= LIMITS ================= -->

    <limit
      lower="-0.445"
      upper="0.445"
      effort="10"
      velocity="2" />

  </joint>



  <!-- ========================================================= -->
  <!-- Hand base (palm carrier)                                  -->
  <!-- ========================================================= -->


  <link name="${prefix}hand_base">

    <!-- ================= INERTIAL ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin
          xyz="-0.00203701184983107 0.0326112668966462 -0.0155668752323911"
          rpy="0 0 0" />
        <mass value="0.175357386592075" />
        <inertia
          ixx="0.000121544991663851"
          ixy="-6.56650332338833E-07"
          ixz="5.20578126071962E-07"
          iyy="7.52780099608673E-05"
          iyz="4.53525030951461E-07"
          izz="7.95760415441486E-05" />
      </inertial>
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin
          xyz="0.00186701184983107 0.0342512668966462 0.0144068752323911"
          rpy="0 0 0" />
        <mass value="1.7535738659E-01" />
        <inertia
          ixx="1.2154499166E-04"
          ixy="6.5665033234E-07"
          ixz="-5.2057812607E-07"
          iyy="7.5278009961E-05"
          iyz="4.5352503095E-07"
          izz="7.9576041544E-05" />
      </inertial>
    </xacro:if>

    <!-- ================= VISUAL ================= -->

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}hand_base.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}hand_base.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>

  <joint
    name="${prefix}hand_base_joint"
    type="revolute">

    <!-- ================= ORIGIN ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <origin
        xyz="0.015 0 -0.0055"
        rpy="-0.11587 1.5708 -0.11587" />
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <origin
        xyz="-0.015 0 0.0055"
        rpy="3.1414 1.5708 3.1414" />
    </xacro:if>

    <parent link="${prefix}wrist_yaw"/>
    <child  link="${prefix}hand_base"/>

    <axis xyz="0 0 -1"/>

    <!-- ================= LIMITS ================= -->

    <limit
      lower="-0.3955"
      upper="0.386"
      effort="10"
      velocity="2"/>

  </joint>



  <!-- ========================================================= -->
  <!-- Fingers: thumb, index, middle, ring, little               -->
  <!-- ========================================================= -->
  <!--
    Mimic joints:
      - Used to reduce control dimensionality
      - Required for realistic finger curling
  -->

  <!-- THUMB -->
  <!-- right_thumb_1, right_thumb_2, ... -->
  <!-- index finger -->
  <!-- middle finger -->
  <!-- ring finger -->
  <!-- little finger -->

  <!-- ============================================================= -->
  <!-- THUMB 1                                                       -->
  <!-- ============================================================= -->

  <link name="${prefix}thumb_1">

    <!-- ================= INERTIAL ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin
          xyz="0.000675346448543043 -0.00433551697891765 -0.00508780193489455"
          rpy="0 0 0" />
        <mass value="0.0048541771537782" />
        <inertia
          ixx="1.96094051160198E-07"
          ixy="3.4858314687744E-08"
          ixz="-3.39249138133518E-09"
          iyy="1.43278984955152E-07"
          iyz="8.1983806766273E-09"
          izz="1.68938152839344E-07" />
      </inertial>
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin
          xyz="0.000675361243917746 0.00433554414064959 -0.00508779581139575"
          rpy="0 0 0" />
        <mass value="4.8541771538E-03" />
        <inertia
          ixx="1.9609405116E-07"
          ixy="-3.4858314688E-08"
          ixz="-3.3924913813E-09"
          iyy="1.4327898496E-07"
          iyz="-8.1983806766E-09"
          izz="1.6893815284E-07" />
      </inertial>
    </xacro:if>

    <!-- ================= VISUAL ================= -->

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}thumb_1.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}thumb_1.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>

  <joint
    name="${prefix}thumb_1_joint"
    type="revolute">

    <!-- ================= ORIGIN ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <origin
        xyz="0.0150000040088096 0.0342999999998856 0.00640000024786605"
        rpy="-1.5707963267949 0 0" />
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <origin
        xyz="-0.0153000040088447 0.0343000000007003 0.036400000219911"
        rpy="1.5707963267949 0 -3.14159265358979" />
    </xacro:if>

    <parent link="${prefix}hand_base"/>
    <child  link="${prefix}thumb_1"/>

     <xacro:if value="${side == 'left'}">
      <axis xyz="0 0 1"/>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <axis xyz="0 0 -1"/>
    </xacro:if>

    <!-- ================= LIMITS ================= -->

    <limit
      lower="0"
      upper="1.310384"
      effort="10"
      velocity="2"/>

  </joint>

  <!-- ============================================================= -->
  <!-- THUMB 2.                                                      -->
  <!-- ============================================================= -->

  <link name="${prefix}thumb_2">

    <!-- ================= INERTIAL ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin
          xyz="0.0217021678253 0.0140075970723664 0.00802372797249204"
          rpy="0 0 0" />
        <mass value="0.011197324578883" />
        <inertia
          ixx="1.69781612625836E-06"
          ixy="-7.99167330982163E-07"
          ixz="6.95615513975465E-10"
          iyy="1.86857468329596E-06"
          iyz="-2.37438335268391E-10"
          izz="3.3501396961086E-06" />
      </inertial>
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin
          xyz="-0.021702059702569 0.0140073366357873 0.00802385604823092"
          rpy="0 0 0" />
        <mass value="1.1197324579E-02" />
        <inertia
          ixx="1.6978161263E-06"
          ixy="7.9916733098E-07"
          ixz="-6.9561551398E-10"
          iyy="1.8685746833E-06"
          iyz="-2.3743833527E-10"
          izz="3.3501396961E-06" />
      </inertial>
    </xacro:if>

    <!-- ================= VISUAL ================= -->

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}thumb_2.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}thumb_2.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>

  <joint
    name="${prefix}thumb_2_joint"
    type="revolute">

    <!-- ================= ORIGIN ================= -->

    <!-- Left -->
    <xacro:if value="${side == 'left'}">
      <origin
        xyz="0.0107038256289916 -0.00903759464150408 -0.00649999999999991"
        rpy="1.5707963267949 0 -1.30899693899575" />
    </xacro:if>

    <!-- Right -->
    <xacro:if value="${side == 'right'}">
      <origin
        xyz="0.0107038256289915 0.00903759464150421 -0.00649999999999998"
        rpy="1.5707963267949 0 -1.83259571459404" />
    </xacro:if>

    <xacro:if value="${side == 'left'}">
      <axis xyz="0 0 1"/>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <axis xyz="0 0 -1"/>
    </xacro:if>


    <parent link="${prefix}thumb_1"/>
    <child  link="${prefix}thumb_2"/>

    <limit
      lower="0"
      upper="0.523477"
      effort="10"
      velocity="2"/>

  </joint>


  <!-- ============================================================= -->
  <!-- THUMB RUBBER 1                                                -->
  <!-- ============================================================= -->

  <link name="${prefix}thumb_rubber_1">

    <!-- ================= INERTIAL ================= -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin xyz="5.40162647625353E-05 0.00265236291170259 -0.00524128392726222"
                rpy="0 0 0"/>
        <mass value="0.0014906283411173"/>
        <inertia
          ixx="1.88752644928606E-07"
          ixy="-3.80267550036779E-11"
          ixz="-3.87652846240887E-10"
          iyy="1.0000000000E-07"
          iyz="3.72404130676968E-09"
          izz="2.26622483357037E-07"/>
      </inertial>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin xyz="5.25123796278198E-05 -0.00265158184532596 -0.00524156527611314"
                rpy="0 0 0"/>
        <mass value="1.4906283411E-03"/>
        <inertia
          ixx="1.8875264493E-07"
          ixy="3.8026755004E-11"
          ixz="-3.8765284624E-10"
          iyy="1.0000000000E-07"
          iyz="-3.7240413068E-09"
          izz="2.2662248336E-07"/>
      </inertial>
    </xacro:if>
    <!-- ============================================================ -->


    <!-- ================= VISUAL ================= -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}thumb_rubber_1.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.298039215686275 0.298039215686275 0.298039215686275 1"/>
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}thumb_rubber_1.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>



  <!-- ================= JOINT ================= -->

  <joint name="${prefix}thumb_rubber_1_joint" type="fixed">

    <xacro:if value="${side == 'left'}">
      <origin
        xyz="0.013046553810162 0.0313855611442985 0.00799913310995912"
        rpy="3.13815940276581 1.56040994467678 -0.950106044051694"/>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <origin
        xyz="-0.013046553810162 0.0313855611442986 0.00799913310995912"
        rpy="-3.13815940276514 1.56040994467676 -2.19148660953744"/>
    </xacro:if>

    <parent link="${prefix}thumb_2"/>
    <child  link="${prefix}thumb_rubber_1"/>

  </joint>

  <!-- ============================================================= -->
  <!-- THUMB 3                                                       -->
  <!-- ============================================================= -->

  <link name="${prefix}thumb_3">

    <!-- ================= INERTIAL ================= -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin
          xyz="0.009163924940713 -0.00021374698947753 0.00749980580117909"
          rpy="0 0 0"/>
        <mass value="0.00226949921461618"/>
        <inertia
          ixx="2.51533206255898E-07"
          ixy="-6.42880570532076E-08"
          ixz="-1.61781119018821E-12"
          iyy="1.99322726365665E-07"
          iyz="-2.2825448825002E-12"
          izz="2.99631274061669E-07"/>
      </inertial>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin
          xyz="-0.00916388835013904 -0.000213690008193602 0.00750028797357696"
          rpy="0 0 0"/>
        <mass value="2.2694992146E-03"/>
        <inertia
          ixx="2.5153320626E-07"
          ixy="6.4288057053E-08"
          ixz="-1.6178111902E-12"
          iyy="1.9932272637E-07"
          iyz="2.2825448825E-12"
          izz="2.9963127406E-07"/>
      </inertial>
    </xacro:if>
    <!-- ============================================================ -->


    <!-- ================= VISUAL ================= -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}thumb_3.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}thumb_3.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>



  <!-- ================= JOINT ================= -->

  <joint name="${prefix}thumb_3_joint" type="revolute">

    <!-- Side dependent joint origin -->
    <xacro:if value="${side == 'left'}">
      <origin
        xyz="0.0415838804016113 0.0375080548719081 0.000500000000000139"
        rpy="0 0 0"/>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <origin
        xyz="-0.0415838804016112 0.0375080548719081 0.00050000000000007"
        rpy="0 0 0"/>
    </xacro:if>

    <xacro:if value="${side == 'left'}">
      <axis xyz="0 0 1"/>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <axis xyz="0 0 -1"/>
    </xacro:if>

    <parent link="${prefix}thumb_2"/>
    <child  link="${prefix}thumb_3"/>

    

    <limit
      lower="0"
      upper="0.606844"
      effort="10"
      velocity="2"/>

    <!-- Mimic remains identical for both sides -->
    <mimic
      joint="${prefix}thumb_2_joint"
      multiplier="1.1425"
      offset="0"/>

  </joint>

  <!-- ============================================================= -->
  <!-- THUMB RUBBER 2                                                -->
  <!-- ============================================================= -->

  <link name="${prefix}thumb_rubber_2">

    <!-- ================= INERTIAL ================= -->
    <xacro:if value="${side == 'left'}">
      <inertial>
        <origin xyz="0.000162364162411777 -0.00288606836963476 -0.00905408809199784"
                rpy="0 0 0"/>
        <mass value="0.000712407867806307"/>
        <inertia
          ixx="1.0000000000E-07"
          ixy="1.57348854903248E-10"
          ixz="1.3517068967957E-10"
          iyy="1.0000000000E-07"
          iyz="-8.47497937683654E-09"
          izz="1.0000000000E-07"/>
      </inertial>
    </xacro:if>

    <xacro:if value="${side == 'right'}">
      <inertial>
        <origin xyz="0.000157140889199783 0.00288556596888331 -0.0090540619335797"
                rpy="0 0 0"/>
        <mass value="7.1240786781E-04"/>
        <inertia
          ixx="1.0000000000E-07"
          ixy="-1.5734885490E-10"
          ixz="1.3517068968E-10"
          iyy="1.0000000000E-07"
          iyz="8.4749793768E-09"
          izz="1.0000000000E-07"/>
      </inertial>
    </xacro:if>


    <!-- ================= VISUAL ================= -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_visual}/${prefix}thumb_rubber_2.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.298039215686275 0.298039215686275 0.298039215686275 1"/>
      </material>
    </visual>

    <!-- ================= COLLISION ================= -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_collision}/${prefix}thumb_rubber_2.STL"/>
      </geometry>
      <material name="">
        <color rgba="1 0 0 1"/>
      </material>
    </collision>

  </link>

  <!-- ================= JOINT ================= -->
   
  <joint name="${prefix}thumb_rubber_2_joint" type="fixed">

    <!-- Left joint origin -->
    <xacro:if value="${side == 'left'}">
      <origin xyz="0.00507003292533287 0.0118736037354008 0.00749998784521017"
              rpy="3.1415926439814 1.5531258063565 -1.04754422345685"/>
    </xacro:if>

    <!-- Right joint origin -->
    <xacro:if value="${side == 'right'}">
