<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
  ros2_control configuration for the UR5e + Inspire RH56DFX system.

  This macro loads initial joint positions from a YAML file and
  applies them to the simulated hardware (GenericSystem). This
  ensures the robot starts in a deterministic configuration when
  the simulation launches.
  -->

  <xacro:macro name="ur5e_rh56dfx_system_ros2_control"
              params="name initial_positions_file hardware">

    <!-- Load joint initial positions from YAML -->
    <xacro:property name="initial_positions_yaml"
                    value="${xacro.load_yaml(initial_positions_file)}"/>

    <xacro:property name="initial_positions"
                    value="${initial_positions_yaml['initial_positions']}"/>

    <ros2_control name="${name}" type="system">
      <hardware>

        <!-- MOCK backend -->
        <xacro:if value="${hardware == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>

        <!-- ISAAC backend -->
        <xacro:if value="${hardware == 'isaac'}">
          <plugin>topic_based_ros2_control/TopicBasedSystem</plugin>
          <param name="joint_commands_topic">/joint_command</param>
          <param name="joint_states_topic">/joint_states</param>
          <param name="trigger_joint_command_threshold">0.0</param>
          <param name="sum_wrapped_joint_states">false</param>
        </xacro:if>

      </hardware>
      <!-- ===================================================== -->
      <!-- UR5e ARM JOINTS                                       -->
      <!-- ===================================================== -->

      <joint name="shoulder_pan_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['shoulder_pan_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="shoulder_lift_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['shoulder_lift_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="elbow_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['elbow_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wrist_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['wrist_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wrist_2_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['wrist_2_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wrist_3_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['wrist_3_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>


      <!-- ===================================================== -->
      <!-- LEFT HAND JOINTS                                      -->
      <!-- ===================================================== -->

      <joint name="left_wrist_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_wrist_yaw_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_hand_base_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_hand_base_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_index_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_index_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_middle_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_middle_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_ring_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_ring_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_little_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_little_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_thumb_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_thumb_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="left_thumb_2_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['left_thumb_2_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>


      <!-- ===================================================== -->
      <!-- RIGHT HAND JOINTS                                     -->
      <!-- ===================================================== -->

      <joint name="right_wrist_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_wrist_yaw_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_hand_base_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_hand_base_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_index_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_index_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_middle_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_middle_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_ring_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_ring_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_little_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_little_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_thumb_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_thumb_1_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

      <joint name="right_thumb_2_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions['right_thumb_2_joint']}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>