<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5e_rh56dfx_moveit_config</name>
  <version>1.0.0</version>
  <description>MoveIt 2 configuration for the UR5e + RH56DFX: SRDF, kinematics, OMPL and Pilz pipelines, controllers and the mock / Isaac Sim hardware switch</description>
  <maintainer email="ookkshirsagar@gmail.com">Omkar Chandrakant Kshirsagar</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/ookkshirsagar/moveit-mtc-pick-and-place</url>
  <author email="ookkshirsagar@gmail.com">Omkar Chandrakant Kshirsagar</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ur5e_rh56dfx_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>
  <exec_depend>moveit_kinematics</exec_depend>
  <exec_depend>moveit_planners_ompl</exec_depend>
  <exec_depend>pilz_industrial_motion_planner</exec_depend>
  <exec_depend>moveit_simple_controller_manager</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>hardware_interface</exec_depend>  <!-- provides mock_components -->
  <exec_depend>topic_based_ros2_control</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>
  <test_depend>ament_cmake_flake8</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
